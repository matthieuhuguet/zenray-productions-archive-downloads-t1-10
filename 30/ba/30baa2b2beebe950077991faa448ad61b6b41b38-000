</script><script id="zenray-glass-runtime">
(() => {
  const selector = [
    ".glass",
    ".pill",
    ".progress-pill",
    ".capsule-label",
    ".card",
    ".group-panel",
    ".toggle-slider",
    ".vd-volume",
    ".vd-morepill",
    ".mini-player",
    ".mini-h",
    ".mini-h2",
    ".mini-player-v2",
    ".sbs-search",
    ".sbs-drop"
  ].join(",");

  const surfaces = [...new Set(document.querySelectorAll(selector))];
  const states = [];
  let raf = 0;

  const makeLayer = className => {
    const viewport = document.createElement("span");
    viewport.className = className;
    viewport.setAttribute("aria-hidden", "true");

    const sample = document.createElement("span");
    sample.className = "zr-refraction-sample";
    viewport.appendChild(sample);

    return {viewport, sample};
  };

  const pickSource = surface =>
    surface.closest(".video-demo") ||
    surface.closest(".sbs-demo") ||
    surface.closest(".museum-stage-canvas") ||
    surface.closest(".light-canvas") ||
    document.body;

  const copyBackground = (source, sample) => {
    const css = getComputedStyle(source);
    sample.style.backgroundColor = css.backgroundColor;
    sample.style.backgroundImage = css.backgroundImage;
    sample.style.backgroundSize = css.backgroundSize;
    sample.style.backgroundPosition = css.backgroundPosition;
    sample.style.backgroundRepeat = css.backgroundRepeat;
    sample.style.backgroundOrigin = css.backgroundOrigin;
    sample.style.backgroundClip = css.backgroundClip;
    sample.style.backgroundAttachment = "scroll";
  };

  const placeSample = (
    state,sample,scaleX,scaleY,bendX,bendY,compensation=0
  ) => {
    const surfaceRect = state.surface.getBoundingClientRect();
    const sourceRect = state.source.getBoundingClientRect();

    const focusX = state.inside ? state.localX : surfaceRect.width * .5;
    const focusY = state.inside ? state.localY : surfaceRect.height * .5;

    const localSourceX = surfaceRect.left - sourceRect.left;
    const localSourceY = surfaceRect.top - sourceRect.top;
    const globalFocusX = localSourceX + focusX;
    const globalFocusY = localSourceY + focusY;

    const tx = focusX - scaleX * globalFocusX + bendX + compensation;
    const ty = focusY - scaleY * globalFocusY + bendY + compensation;

    sample.style.left = `${-compensation}px`;
    sample.style.top = `${-compensation}px`;
    sample.style.width = `${sourceRect.width}px`;
    sample.style.height = `${sourceRect.height}px`;
    sample.style.transform =
      `translate3d(${tx.toFixed(3)}px,${ty.toFixed(3)}px,0) ` +
      `scale(${scaleX.toFixed(5)},${scaleY.toFixed(5)})`;
  };

  const renderState = state => {
    state.currentX += (state.targetX - state.currentX) * .12;
    state.currentY += (state.targetY - state.currentY) * .12;

    const rect = state.surface.getBoundingClientRect();
    const ring = Math.min(
      13,
      Math.max(5,Math.min(rect.width,rect.height) * .14)
    );
    state.surface.style.setProperty("--zr-ring",`${ring.toFixed(2)}px`);

    copyBackground(state.source,state.core.sample);
    copyBackground(state.source,state.rim.sample);

    placeSample(
      state,
      state.core.sample,
      1.012 + Math.abs(state.currentX) * .0015,
      1.009 + Math.abs(state.currentY) * .0012,
      -state.currentX * 2.6,
      -state.currentY * 1.9
    );

    placeSample(
      state,
      state.rim.sample,
      1.050 + Math.abs(state.currentX) * .003,
      1.038 + Math.abs(state.currentY) * .0025,
      -state.currentX * 7.8,
      -state.currentY * 5.6,
      ring
    );

    return (
      Math.abs(state.currentX - state.targetX) > .001 ||
      Math.abs(state.currentY - state.targetY) > .001
    );
  };

  const frame = () => {
    let moving = false;
    for(const state of states){
      moving = renderState(state) || moving;
    }

    if(moving){
      raf = requestAnimationFrame(frame);
    }else{
      raf = 0;
    }
  };

  const schedule = () => {
    if(!raf) raf = requestAnimationFrame(frame);
  };

  for(const [index,surface] of surfaces.entries()){
    surface.classList.add("zenray-glass-surface");
    surface.dataset.zenrayGlassIndex = String(index + 1);

    const source = pickSource(surface);
    const brightContext =
      document.body.classList.contains("zenray-theme-light") ||
      Boolean(surface.closest('.museum-stage[data-tone="rose"]')) ||
      Boolean(surface.closest(".video-demo"));

    surface.classList.toggle("zenray-on-bright",brightContext);

    const core = makeLayer("zr-refraction zr-refraction-core");
    const rim = makeLayer("zr-refraction zr-refraction-rim");
    const fill = document.createElement("span");
    const opticalRim = document.createElement("span");

    fill.className = "zr-glass-fill";
    fill.setAttribute("aria-hidden","true");
    opticalRim.className = "zr-optical-rim";
    opticalRim.setAttribute("aria-hidden","true");

    surface.prepend(opticalRim);
    surface.prepend(fill);
    surface.prepend(rim.viewport);
    surface.prepend(core.viewport);

    const rect = surface.getBoundingClientRect();
    const state = {
      surface,
      source,
      core,
      rim,
      targetX:0,
      targetY:0,
      currentX:0,
      currentY:0,
      localX:rect.width * .5,
      localY:rect.height * .5,
      inside:false
    };

    const readPointer = event => {
      const currentRect = surface.getBoundingClientRect();
      state.localX = Math.max(
        0,
        Math.min(currentRect.width,event.clientX - currentRect.left)
      );
      state.localY = Math.max(
        0,
        Math.min(currentRect.height,event.clientY - currentRect.top)
      );
      state.targetX =
        (state.localX / Math.max(1,currentRect.width) - .5) * 2;
      state.targetY =
        (state.localY / Math.max(1,currentRect.height) - .5) * 2;
      state.inside = true;
      schedule();
    };

    surface.addEventListener("pointerenter",readPointer,{passive:true});
    surface.addEventListener("pointermove",readPointer,{passive:true});
    surface.addEventListener("pointerleave",() => {
      state.inside = false;
      state.targetX = 0;
      state.targetY = 0;
      schedule();
    },{passive:true});

    states.push(state);
  }

  const refreshAll = () => {
    for(const state of states){
      state.source = pickSource(state.surface);
    }
    schedule();
  };

  window.addEventListener("resize",refreshAll,{passive:true});
  document.addEventListener(
    "scroll",
    refreshAll,
    {passive:true,capture:true}
  );

  if("ResizeObserver" in window){
    const observer = new ResizeObserver(refreshAll);
    surfaces.forEach(surface => observer.observe(surface));
  }

  refreshAll();

  window.__ZENRAY_GLASS__ = {
    count:surfaces.length,
    refresh:refreshAll
  };
})();
