<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ZenRay — Test tailles UI 4K, 9 à 18 px</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #0c0d10;
      color: #f2f3f5;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 32px;
      background:
        radial-gradient(circle at top left, rgba(255,255,255,.05), transparent 32%),
        #0c0d10;
    }

    .toolbar {
      position: sticky;
      top: 16px;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      gap: 12px 18px;
      align-items: center;
      margin-bottom: 24px;
      padding: 12px 14px;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 14px;
      background: rgba(18,19,24,.88);
      backdrop-filter: blur(18px);
    }

    .toolbar label,
    .toolbar span {
      font-size: 13px;
      color: #c9cbd1;
    }

    .toolbar select {
      padding: 7px 10px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 9px;
      background: #191b20;
      color: white;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .sample {
      min-height: 420px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(34,36,43,.95), rgba(19,20,25,.95));
      box-shadow: 0 18px 60px rgba(0,0,0,.28);
    }

    .sample-header {
      padding: 14px 16px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      background: rgba(5,6,8,.48);
    }

    .sample-header strong {
      font-size: 16px;
      letter-spacing: .01em;
    }

    .breadcrumb {
      margin-top: 8px;
      padding: 8px 10px;
      border-radius: 9px;
      background: rgba(0,0,0,.38);
      color: #d7d8dc;
    }

    .content { padding: 14px; }

    .nav-item,
    .task {
      margin-bottom: 9px;
      padding: 10px 11px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 10px;
      background: rgba(255,255,255,.035);
      line-height: 1.35;
    }

    .task small {
      display: block;
      margin-top: 5px;
      font-size: .82em;
      color: #9da1aa;
    }

    .verdict {
      margin-top: 24px;
      padding: 16px 18px;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 14px;
      background: rgba(255,255,255,.04);
      font-size: 14px;
      line-height: 1.55;
      color: #d8dae0;
    }

    @media (max-width: 640px) {
      body { padding: 16px; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <label for="zoom">Simulation du scaling écran :</label>
    <select id="zoom">
      <option value="1">100 %</option>
      <option value="1.25">125 %</option>
      <option value="1.5">150 %</option>
      <option value="2">200 % / Retina</option>
    </select>
    <span>Comparaison continue : 9 px → 18 px, par incréments de 1 px.</span>
  </div>

  <main id="preview">
    <div class="grid" id="grid"></div>

    <div class="verdict">
      <strong>Repère rapide :</strong>
      9–11 px = microtexte ; 12–13 px = interface dense ; 14 px = équilibre ;
      15–16 px = confort ; 17–18 px = lecture forte ou interface plus massive.
    </div>
  </main>

  <script>
    const grid = document.getElementById("grid");

    for (let size = 9; size <= 18; size++) {
      const sample = document.createElement("section");
      sample.className = "sample";
      sample.style.fontSize = `${size}px`;
      sample.innerHTML = `
        <div class="sample-header">
          <strong>${size} px</strong>
          <div class="breadcrumb">Create / Plan / Production</div>
        </div>
        <div class="content">
          <div class="nav-item">Dashboard</div>
          <div class="nav-item">Create</div>
          <div class="nav-item">Media Library</div>
          <div class="task">
            Finaliser le système de playlists
            <small>Priorité haute · Aujourd’hui</small>
          </div>
          <div class="task">
            Améliorer le contraste du fil d’Ariane
            <small>UI polish · ZenRay</small>
          </div>
        </div>
      `;
      grid.appendChild(sample);
    }

    const select = document.getElementById("zoom");
    const preview = document.getElementById("preview");

    select.addEventListener("change", () => {
      const value = Number(select.value);
      preview.style.transformOrigin = "top left";
      preview.style.transform = `scale(${value})`;
      preview.style.width = `${100 / value}%`;
    });
  </script>
</body>
</html>
