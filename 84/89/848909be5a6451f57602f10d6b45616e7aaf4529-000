/* =============================================================
   V7 material system — CSS only. No injected nodes, no changed DOM.
   ============================================================= */
:is(.theme-dark,.theme-light)
:is(
  .glass,.pill,.progress-pill,.capsule-label,.card,
  .group-panel,.toggle-slider,.vd-volume,.vd-morepill,
  .mini-player,.mini-h,.mini-h2,.mini-player-v2,
  .sbs-search,.sbs-drop
){
  --lens-x:0px;
  --lens-y:0px;
  --pointer-x:50%;
  --pointer-y:50%;
  position:relative;
  isolation:isolate;
  overflow:hidden;
  border:0 !important;
  color:var(--theme-fg) !important;
  background:
    linear-gradient(135deg,var(--glass-a),var(--glass-b)) !important;
  -webkit-backdrop-filter:blur(27px) saturate(169%) !important;
  backdrop-filter:blur(27px) saturate(169%) !important;
  box-shadow:
    var(--outer-line),
    inset 0 1px 0 var(--rim-main),
    inset 0 -1px 0 var(--rim-main),
    inset 0 2px 0 var(--rim-soft),
    inset 0 -2px 0 var(--rim-soft),
    inset 1px 0 0 var(--rim-side),
    inset -1px 0 0 var(--rim-side),
    var(--elevation-a),
    var(--elevation-b) !important;
}

/* A clipped, transformed optical layer supplies subtle Liquid Glass motion
   without adding or reordering children. */
:is(.theme-dark,.theme-light)
:is(
  .glass,.pill,.progress-pill,.capsule-label,.card,
  .group-panel,.toggle-slider,.vd-volume,.vd-morepill,
  .mini-player,.mini-h,.mini-h2,.mini-player-v2,
  .sbs-search,.sbs-drop
)::before{
  content:"";
  position:absolute;
  inset:-7px;
  z-index:0;
  pointer-events:none;
  border-radius:inherit;
  background:
    radial-gradient(circle at var(--pointer-x) var(--pointer-y),rgba(255,255,255,.14),transparent 30%),
    linear-gradient(118deg,rgba(255,255,255,.055),transparent 24% 76%,rgba(255,255,255,.025));
  -webkit-backdrop-filter:blur(2px) saturate(112%);
  backdrop-filter:blur(2px) saturate(112%);
  transform:translate3d(var(--lens-x),var(--lens-y),0) scale(1.025);
  transform-origin:var(--pointer-x) var(--pointer-y);
  transition:transform .28s var(--ease);
}

/* The original noise was Acrylic-like and is intentionally disabled. */
:is(.theme-dark,.theme-light) .noise{display:none !important}

/* Content contrast: never white and dark at the same time. */
:is(.theme-dark,.theme-light) .v6-canvas{
  color:var(--theme-fg);
}
:is(.theme-dark,.theme-light) .v6-canvas :is(
  button,.glass,.pill,.progress-pill,.capsule-label,.card,
  .group-panel,.toggle-slider,.vd-volume,.vd-morepill,
  .mini-player,.mini-h,.mini-h2,.mini-player-v2,
  .sbs-search,.sbs-drop,.card-title,.mini-title,.mini-h-title,
  .sbs-input,.sbs-row strong,.sbs-group-head h4
){
  color:var(--theme-fg) !important;
}
:is(.theme-dark,.theme-light) .v6-canvas :is(
  label,.card-sub,.mini-sub,.mini-h-sub,.sbs-row small,
  .sbs-pagination,.mini-progress,.mini-h-progress,.mini-h2-progress
){
  color:var(--theme-muted) !important;
}
:is(.theme-dark,.theme-light) .v6-canvas :is(
  .track,.progress-rail,.mini-rail,.mini-h-rail,
  .mini-h2-rail,.mini-h2-volume-track
){
  background:var(--theme-rail) !important;
}
:is(.theme-dark,.theme-light) .v6-canvas :is(
  .track,.progress-rail,.mini-rail,.mini-h-rail,
  .mini-h2-rail,.mini-h2-volume-track
) > i{
  background:var(--theme-fill) !important;
}

/* White state always uses a dark icon. */
:is(.theme-dark,.theme-light) .glass.active{
