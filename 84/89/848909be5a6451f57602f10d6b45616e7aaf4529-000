<script id="zenray-v8-runtime">
(() => {
  const selector = [
    '.glass','.pill','.progress-pill','.capsule-label','.card',
    '.group-panel','.toggle-slider','.vd-volume','.vd-morepill',
    '.mini-player','.mini-h','.mini-h2','.mini-player-v2',
